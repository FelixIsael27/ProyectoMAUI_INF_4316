<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stock_Facil.Views.Productos.ProductoListPage"
             Title="Productos">

    <Button
        Text="Nuevo Producto"
        Clicked="NuevoProducto_Clicked"/>

    <CollectionView
        x:Name="ListaProductos">

        <CollectionView.ItemTemplate>

            <DataTemplate>

                <Frame Margin="10">

                    <VerticalStackLayout>

                        <Label
                            FontSize="20"
                            FontAttributes="Bold"
                            Text="{Binding Nombre}" />

                        <Label
                            Text="{Binding Codigo}" />

                        <Label
                            Text="{Binding Categoria}" />

                        <Label
                            Text="{Binding Precio}" />

                        <Label
                            Text="{Binding Cantidad}" />

                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>