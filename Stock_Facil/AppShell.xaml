<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Stock_Facil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Stock_Facil"
    Title="Stock_Facil">

    <FlyoutItem
        Title="Inicio">

        <ShellContent
            Title="Inicio"
            Route="home"
            ContentTemplate="{DataTemplate view:HomePage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Productos">

        <ShellContent
            Title="Listado"
            Route="productos"
            ContentTemplate="{DataTemplate producto:ProductoListPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Registrar Producto">

        <ShellContent
            Title="Nuevo"
            Route="nuevoProducto"
            ContentTemplate="{DataTemplate producto:ProductoFormPage}" />

    </FlyoutItem>

    <MenuItem
        Text="Cerrar sesión"
        Clicked="CerrarSesion_Clicked"/>

</Shell>
