<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stock_Facil.Views.HomePage"
             Title="Inicio">
    
    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="Bienvenido a Stock Fácil"
                FontSize="28"
                FontAttributes="Bold"/>

            <Frame
                CornerRadius="12"
                Padding="20">

                <VerticalStackLayout>

                    <Label
                        Text="Sistema Básico de Inventario"/>

                    <Label
                        Text="Elija una opción para comenzar."/>

                </VerticalStackLayout>

            </Frame>

            <Button
                Text="Productos"/>

            <Button
                Text="Categorías"/>

            <Button
                Text="Proveedores"/>

            <Button
                Text="Ver Productos"
                Clicked="VerProductos_Clicked"/>

            <Button
                Text="Registrar Producto"
                Clicked="RegistrarProducto_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>